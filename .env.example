OPENAI_BASE_URL=https://ollama.com
# Vision-capable model;
# use an exact id from https://ollama.com/api/tags (tag required, e.g. gemma4:31b).
OPENAI_VISION_MODEL=gemma4:31b
OPENAI_API_KEY=ollama_api_key_here

# Root folder to scan (recursive)
IMAGE_LIBRARY_ROOT=C:/Users/user/Pictures

# Vector index for CLIP search (SQLite). Default: ~/.cache/images-agent/embeddings.sqlite
IMAGE_INDEX_SQLITE=C:/Users/user/.cache/images-agent/embeddings.sqlite
# Paired ONNX CLIP models (FastEmbed IDs)
CLIP_VISION_EMBED_MODEL=Qdrant/clip-ViT-B-32-vision
CLIP_TEXT_EMBED_MODEL=Qdrant/clip-ViT-B-32-text

# Default cap for `images-agent run` (CLIP mode) when -n/--limit is omitted (use -n 0 for no cap).
IMAGE_AGENT_VECTOR_TOP_K=100
