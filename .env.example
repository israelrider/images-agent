# Ollama Cloud (https://docs.ollama.com/cloud) — create key at https://ollama.com/settings/keys
OLLAMA_API_KEY=your_ollama_api_key_here
OLLAMA_HOST=https://ollama.com
# Vision-capable cloud model (see https://ollama.com/search?c=cloud)
OLLAMA_VISION_MODEL=gemma3

# Root folder to scan (recursive)
IMAGE_LIBRARY_ROOT=C:/Users/user/Pictures
